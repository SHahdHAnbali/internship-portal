# Frontend environment (copy to .env and fill in). Never commit real values.
# Every VITE_* value is bundled into the browser build, so only public values belong here.

# Base URL of the NestJS backend API. Defaults to http://localhost:3000 when unset.
VITE_API_URL=http://localhost:3000

# Supabase project URL. Required.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase publishable (anon) key. Required. Never put the secret / service-role key here.
VITE_SUPABASE_ANON_KEY=<publishable-key>
