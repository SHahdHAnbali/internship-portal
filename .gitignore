# Internship Portal — repository-wide ignore rules.
# backend/, frontend/ and supabase/ keep their own .gitignore files as well.

# Environment files and secrets (examples stay tracked)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Dependencies
node_modules/

# Build output and caches
dist/
dist-ssr/
build/
*.tsbuildinfo
.vite/
.eslintcache

# Test output
coverage/
.nyc_output/

# Logs and runtime files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.pid
*.pid.lock

# Temporary files
.tmp/
tmp/
*.tmp
*.swp
*.sw?

# Third-party agent skill files (not published: upstream MIT notice not included;
# reinstall locally from backend/skills-lock.json)
backend/.agents/

# Supabase local state (linked project metadata, branches)
supabase/.temp/
supabase/.branches/

# OS files
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.sublime-workspace
