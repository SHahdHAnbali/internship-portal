# Backend environment (copy to .env and fill in). Never commit real values.

# Supabase project URL and the secret (service-role) key. Backend only.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=<secret-key>

# CV information extraction (OpenRouter).
OPENROUTER_API_KEY=<openrouter-key>

# Application review emails (Resend).
RESEND_API_KEY=<resend-key>
# Sender on a domain verified in Resend, e.g. "Internship Portal <no-reply@example.com>".
# Required when NODE_ENV=production; without it only the Resend account owner receives emails.
EMAIL_FROM=
# Public address of the frontend, used in review links.
FRONTEND_URL=http://localhost:5173

# Development only: redirect every application review email to this inbox.
# Leave unset in production.
APPLICATION_REVIEW_EMAIL_OVERRIDE=

# development for local work; production is set by npm run start:prod.
NODE_ENV=development
